# Server. Railway supplies PORT; keep default locally.
PORT=3000
NODE_ENV=development
# Production: set to the generated Railway HTTPS origin (no trailing slash).
PUBLIC_ORIGIN=
# 0 locally. Railway: 1, if there is exactly one trusted ingress proxy.
TRUST_PROXY=0
# Required in production, minimum 16 characters. Basic auth only over HTTPS.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Dedicated disposable folder. Contents are deleted on startup. Do not share replicas.
STREAM_DIR=./data/streams
# Conservative free-tier default. Raise to 5–10 only after measuring memory/egress.
MAX_STREAMS=2
MAX_VIEWERS_PER_STREAM=250
IDLE_GRACE_SECONDS=120
VIEWER_TTL_SECONDS=45
HEARTBEAT_SECONDS=12
EXTRACT_TIMEOUT_SECONDS=18
STARTUP_TIMEOUT_SECONDS=35
EXTRACT_RETRIES=2
RETRY_BASE_MS=500
MAINTENANCE_SECONDS=5
STALL_TIMEOUT_SECONDS=45
TERMINAL_RETENTION_SECONDS=300
MAX_TERMINAL_STREAMS=100
# Optional comma-separated operator-approved canonical video IDs; blank allows any live video.
ALLOWED_VIDEO_IDS=
SUBMISSION_WINDOW_SECONDS=60
SUBMISSIONS_PER_WINDOW=10
MAX_RATE_KEYS=10000
# Concurrent channel-discovery requests; video extraction is bounded by MAX_STREAMS.
MAX_RESOLVERS=2
RESOLVE_CACHE_SECONDS=30
MAX_RESOLVE_CACHE=250
HLS_SEGMENT_SECONDS=4
HLS_LIST_SIZE=8
SINGLE_HEIGHT=720
# ABR re-muxes existing source qualities only, without transcoding.
ABR_ENABLED=false
ABR_HEIGHTS=360,480,720
MIN_FREE_DISK_MB=128
MAX_HLS_DISK_MB=400
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Optional operator-provided Netscape cookies file. Never commit cookies.
YT_DLP_COOKIES_FILE=
LOG_BUFFER_SIZE=200
# Local-only deterministic FFmpeg test signal. Never silently substitutes for real YouTube.
DEMO_MODE=false
