    "postinstall": "node scripts/vendor.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "dotenv": "^16.6.1",
    "hls.js": "^1.6.13",
    "@fontsource/vazirmatn": "^5.2.7",
    "@fontsource/inter": "^5.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
