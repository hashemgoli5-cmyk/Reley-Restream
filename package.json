{
  "name": "relay-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
